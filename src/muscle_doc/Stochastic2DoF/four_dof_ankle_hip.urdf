<?xml version="1.0"?>
<robot name="four_dof_ankle_hip">

  <!-- Coordinate convention:
       x = medio-lateral, y = anterior-posterior, z = vertical.
       q0 ankle dorsiflexion (+) / plantarflexion (-), axis x.
       q1 ankle eversion (+) / inversion (-), axis y.
       q2 hip flexion (+) / extension (-), axis x.
       q3 hip abduction (+) / adduction (-), axis y.
  -->

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.25 0.35 0.05"/></geometry>
      <material name="base"><color rgba="0.25 0.25 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.25 0.35 0.05"/></geometry>
    </collision>
  </link>

  <!-- Massless intermediate link used to represent a 2-DOF ankle. -->
  <link name="ankle_flexion_link"/>

  <joint name="ankle_flexion" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="ankle_flexion_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.60" upper="0.60" effort="250" velocity="5.0"/>
  </joint>

  <link name="leg_pelvis">
    <inertial>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="1.70" ixy="0" ixz="0" iyy="1.70" iyz="0" izz="0.18"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry><box size="0.18 0.18 0.90"/></geometry>
      <material name="legs"><color rgba="0.25 0.45 0.85 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry><box size="0.18 0.18 0.90"/></geometry>
    </collision>
  </link>

  <joint name="ankle_eversion" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="ankle_flexion_link"/>
    <child link="leg_pelvis"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="120" velocity="4.0"/>
  </joint>

  <!-- Massless intermediate link used to represent a 2-DOF hip. -->
  <link name="hip_flexion_link"/>

  <joint name="hip_flexion" type="revolute">
    <origin xyz="0 0 0.90" rpy="0 0 0"/>
    <parent link="leg_pelvis"/>
    <child link="hip_flexion_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.00" upper="1.00" effort="300" velocity="5.0"/>
  </joint>

  <link name="trunk">
    <inertial>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="1.70" ixy="0" ixz="0" iyy="1.70" iyz="0" izz="0.30"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry><box size="0.30 0.22 0.60"/></geometry>
      <material name="trunk"><color rgba="0.85 0.40 0.25 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.30" rpy="0 0 0"/>
      <geometry><box size="0.30 0.22 0.60"/></geometry>
    </collision>
  </link>

  <joint name="hip_abduction" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="hip_flexion_link"/>
    <child link="trunk"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.70" upper="0.70" effort="300" velocity="5.0"/>
  </joint>

  <link name="head_marker"/>
  <joint name="head_marker_fixed" type="fixed">
    <origin xyz="0 0 0.60" rpy="0 0 0"/>
    <parent link="trunk"/>
    <child link="head_marker"/>
  </joint>

</robot>
